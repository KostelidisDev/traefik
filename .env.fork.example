# Copy to .env, fill in, then: chmod 600 .env  (never commit .env)

# Pin exact versions — check Docker Hub for the current releases.
TRAEFIK_TAG=v3.7.13
SOCKET_PROXY_REPOSITORY=ghcr.io/kostelidisdev/docker-socket-proxy
SOCKET_PROXY_TAG=v0.5.0.1

DOMAIN=example.com
ACME_EMAIL=admin@example.com

# Cloudflare API token with Zone:DNS:Edit on the zone (not the Global API Key)
CF_DNS_API_TOKEN=

# Generate with: htpasswd -nbB admin 'your-password'
# Use SINGLE quotes: Compose would otherwise try to expand the $ in the hash.
TRAEFIK_DASHBOARD_AUTH='admin:$2y$05$replace-with-your-hash'

# Optional overrides
TZ=Europe/Athens
TRAEFIK_LOG_LEVEL=INFO
TRAEFIK_READ_TIMEOUT=600
TRAEFIK_WRITE_TIMEOUT=600
TRAEFIK_CPU_LIMIT=1
TRAEFIK_MEM_LIMIT=128M
TRAEFIK_MEM_RESERVATION=64M
TRAEFIK_PIDS_LIMIT=200

# Subnets of the shared "traefik" Docker network (IPv4 + IPv6).
# Pick ranges that don't overlap your LAN or other Docker networks.
TRAEFIK_NETWORK_SUBNET_V4=10.100.0.0/24
TRAEFIK_NETWORK_SUBNET_V6=fd00:100::/64
